{
	"name": "blog",
	"version": "1.1.0",
	"author": {
		"name": "Raul Parralejo",
		"email": "namoracon@gmail.com",
		"url": "https://github.com/raohmaru"
	},
	"repository": {
		"type": "git",
		"url": "git://github.com/raohmaru/blog.git"
	},
	"devDependencies": {
		"@11ty/eleventy": "3.1.6",
		"@11ty/eleventy-navigation": "1.0.5",
		"@11ty/eleventy-plugin-syntaxhighlight": "5.0.2",
		"luxon": "3.7.2",
		"markdown-it-link-attributes": "4.0.1",
		"prismjs": "1.30.0"
	},
	"description": "Raohmaru's blog web site using the Eleventy site generator.",
	"engines": {
		"bun": ">=1.3"
	},
	"homepage": "https://raohmaru.github.io/blog",
	"license": "MIT",
	"scripts": {
		"build": "bunx @11ty/eleventy --pathprefix=/blog/",
		"watch": "bunx @11ty/eleventy --pathprefix=/blog/ --watch --quiet",
		"start": "bunx @11ty/eleventy --pathprefix=/blog/ --serve --quiet",
		"debug": "DEBUG=Eleventy* bunx @11ty/eleventy",
		"debugstart": "DEBUG=Eleventy* bunx @11ty/eleventy --serve --quiet",
		"benchmark": "DEBUG=Eleventy:Benchmark* bunx @11ty/eleventy"
	},
	"type": "module"
}
