---
eleventyNavigation:
  key: Tags
---
{%- css %}{% include "public/css/tags.css" %}{% endcss %}

<h1>Tags</h1>

<ul class="tags">
{% for tag in collections | getKeys | filterTagList | sortAlphabetically %}
	{% set tagUrl %}/tags/{{ tag | slugify }}/{% endset %}
	<li><a href="{{ tagUrl }}" class="post-tag invert-dark-b nounderline">{{ tag }}</a></li>
{% endfor %}
</ul>
